[Unit]
Description=DoxaBoard display agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=doxaboard
Group=doxaboard
SupplementaryGroups=video render audio input
ExecStart=/usr/local/bin/doxaboard-agent -config /etc/doxaboard/agent.json
Restart=always
RestartSec=3
# The agent caches state and photos here; survives reboots.
StateDirectory=doxaboard
StateDirectoryMode=0700
# Hardening: the agent only needs the network, the GPU and its state dir.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/doxaboard

[Install]
WantedBy=multi-user.target
