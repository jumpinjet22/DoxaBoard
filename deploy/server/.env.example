# Copy to .env and fill in. Never commit .env.

# Long random strings. Generate with: openssl rand -hex 24
DOXABOARD_ADMIN_TOKEN=
DOXABOARD_ENROLLMENT_TOKEN=

# Multicast group:port the relay sends to. Pick something in 239.0.0.0/8
# (organization-local scope). TTL 1-2 keeps it on your LAN.
MULTICAST_ADDR=239.10.10.1:5000
MULTICAST_TTL=2
# Server IP on the screen network, if the server has more than one interface.
MULTICAST_IFACE_ADDR=

# Time zone for the live schedule (IANA name), e.g. America/Chicago,
# America/New_York, Europe/London. Empty = the server's system time zone.
DOXABOARD_TIMEZONE=

# Optional: a token that can ONLY go live, end, and read live status.
# Put this one on a Stream Deck / Companion button, not the admin token.
# Generate with: openssl rand -hex 24
DOXABOARD_LIVE_TOKEN=

# Vimeo, YouTube, Facebook stream URLs and keys are set up in the admin
# console (Live tab), not here. Keys are stored encrypted.

# OneDrive folder to mirror (after `docker compose run --rm rclone config`,
# name the remote "onedrive"). Each subfolder becomes an album.
ONEDRIVE_PATH=DoxaBoard
ONEDRIVE_SYNC_SECONDS=600
