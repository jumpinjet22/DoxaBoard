// Package {{.Package}} is a DoxaBoard connector for {{.Title}}.
//
// Generated by `doxaboard-connector new {{.Name}}`. Search for TODO.
package {{.Package}}

import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"
	"net/url"
	"strings"
	"time"

	"github.com/jumpinjet22/doxaboard/connectors/registry"
	"github.com/jumpinjet22/doxaboard/slides"
)

func init() { registry.Register(Connector{}) }

// Connector creates {{.Title}} sources.
type Connector struct{}

// Info describes the connector. The admin console builds its form from Fields.
func (Connector) Info() registry.Info {
	return registry.Info{
		Name:        "{{.Name}}",
		Title:       "{{.Title}}",
		Description: "Slides from {{.Title}}.", // TODO: one sentence for the console
		Status:      registry.StatusExperimental,
		Maintainer:  "@your-github-handle", // TODO
		Fields: []registry.Field{
			{Key: "base_url", Label: "{{.Title}} URL", Type: registry.FieldURL, Required: true,
				Help: "e.g. https://cms.example.org"},
			{Key: "api_key", Label: "API key", Type: registry.FieldSecret,
				Help: "Read-only key. Never shown again after saving."},
		},
	}
}

// New validates config. It must not do I/O.
func (Connector) New(cfg registry.Config, deps registry.Deps) (registry.Source, error) {
	base, err := url.Parse(strings.TrimRight(cfg["base_url"], "/"))
	if err != nil || base.Host == "" {
		return nil, fmt.Errorf("base_url is required")
	}
	return &source{base: base, apiKey: cfg["api_key"], deps: deps}, nil
}

type source struct {
	base   *url.URL
	apiKey string
	deps   registry.Deps
}

// item is one record from the {{.Title}} API.
// TODO: match your CMS's real response.
type item struct {
	ID       string     `json:"id"`
	Title    string     `json:"title"`
	Summary  string     `json:"summary"`
	ImageURL string     `json:"image_url"`
	Start    *time.Time `json:"start"`
	End      *time.Time `json:"end"`
	Updated  *time.Time `json:"updated"`
}

// Fetch returns current slides. On any upstream failure it returns an error,
// never an empty list, so the server keeps showing the last good slides.
func (s *source) Fetch(ctx context.Context) ([]slides.Slide, error) {
	// TODO: your CMS's endpoint, filters and pagination.
	endpoint := s.base.JoinPath("api", "items")

	req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
	if err != nil {
		return nil, err
	}
	req.Header.Set("Accept", "application/json")
	if s.apiKey != "" {
		req.Header.Set("Authorization", "Bearer "+s.apiKey) // TODO: your CMS's auth header
	}
	resp, err := s.deps.HTTP.Do(req) // always deps.HTTP: it enforces the allowed hosts
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	if err := registry.CheckStatus(resp); err != nil {
		return nil, err
	}
	body, err := registry.ReadLimited(resp.Body, 0)
	if err != nil {
		return nil, err
	}
	var items []item
	if err := json.Unmarshal(body, &items); err != nil {
		return nil, fmt.Errorf("{{.Name}}: unexpected response: %w", err)
	}

	out := make([]slides.Slide, 0, len(items))
	for i, it := range items {
		if it.ID == "" {
			continue
		}
		sl := slides.Slide{
			ID:        "{{.Name}}:" + it.ID, // stable across fetches
			Title:     it.Title,
			Body:      it.Summary, // plain text only; strip HTML if your CMS returns it
			StartsAt:  it.Start,
			ExpiresAt: it.End,
			UpdatedAt: it.Updated,
			Order:     i * 10,
		}
		if it.ImageURL != "" {
			img, err := endpoint.Parse(it.ImageURL) // resolves relative URLs
			if err == nil && (img.Scheme == "http" || img.Scheme == "https") {
				sl.Image = &slides.Image{URL: img.String(), Alt: it.Title}
			}
		}
		out = append(out, sl)
	}
	return out, nil
}
